    ('Perl',        '5.40.0'),
    ('Archive-Zip', '1.68'),
    ('BioPerl',     '1.7.8'),
    ('libSBML',     '5.20.5', '', ('GCC', '14.2.0')),
    ('unixODBC',    '2.3.14'),
    ('XML-LibXML',  '2.0210'),
]

