easyblock = 'PerlBundle'

name = 'Perl-bundle-extraSIB'
version = '20260423'

homepage = 'https://www.perl.org/'
description = """Perl requirements for Vital-IT, mainly for the MetaNetX project"""

toolchain = {'name': 'GCCcore', 'version': '14.2.0'}
toolchainopts = {'pic': True}

builddependencies = [
    ('binutils', '2.42'),
]

